</div>
</header>
<!-- MAIN WRAPPER -->
<div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col md:flex-row gap-6">
<!-- SIDE NAVIGATION MENU -->
<aside class="w-full md:w-64 flex-shrink-0">
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sticky top-22">
<div class="px-3 py-2 text-xs font-semibold uppercase tracking-wider text-slate-400" id="roleBadge">FOUNDER ACCESS</div>
<nav class="mt-2 space-y-1" id="sideNav">
<!-- Dynamically Populated Side Links based on Role -->
</nav>
<div id="quickStats" class="mt-6 pt-4 border-t border-slate-100 space-y-3">
<div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Workspace Summary</div>
<div class="flex justify-between items-center text-xs">
<span class="text-slate-600">Active Headcount</span>
<span class="font-bold text-slate-900" id="statHeadcount">28</span>
</div>
<div class="flex justify-between items-center text-xs">
<span class="text-slate-600">Pending Approvals</span>
<span class="font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full" id="statApprovals">3</span>
</div>
</div>
</div>
</aside>
<!-- CONTENT AREA -->
<main class="flex-1 min-w-0" id="mainContent">
<!-- Dynamic Workspace Views Rendered Here -->
</main>
