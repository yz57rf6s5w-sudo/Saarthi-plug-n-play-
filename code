Hello! I'm <strong>Saarthi AI</strong>. Ask me about your onboarding tasks, leave balances, reimbursement rules, or company playbook policies.
</div>
</div>
<div class="p-3 bg-white border-t border-slate-200 flex space-x-2">
<input type="text" id="aiInput" placeholder="Ask Saarthi (e.g., How do I apply for leave?)..." class="flex-1 border border-slate-300 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-indigo-500" onkeydown="if(event.key==='Enter') sendAiQuery()">
<button onclick="sendAiQuery()" class="bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-semibold hover:bg-indigo-700 transition">Send</button>
</div>
</div>
</div>
<script>
// GLOBAL APP STATE & PERSISTENCE
const DEFAULT_DATA = {
activeRole: 'founder',
leaves: [
{ id: 1, employee: 'Ananya Sharma', type: 'Casual Leave', days: 2, status: 'Pending', date: '2026-10-28', reason: 'Personal work' },
{ id: 2, employee: 'Rohan Mehta', type: 'Sick Leave', days: 1, status: 'Approved', date: '2026-10-20', reason: 'Fever' }
],
reimbursements: [
{ id: 101, employee: 'Priya Verma', category: 'Software / SaaS', amount: '₹2,499', status: 'Pending', desc: 'Figma Subscription' },
{ id: 102, employee: 'Vikram Patel', category: 'Client Lunch', amount: '₹1,850', status: 'Approved', desc: 'Meeting with prospective client' }
],
shoutouts: [
{ from: 'Arjun Das', to: 'Rohan Mehta', badge: '🚀 Champion', text: 'Kudos for resolving the production database latency bug within 30 minutes!' },
{ from: 'People Ops', to: 'Priya Verma', badge: '💡 Innovator', text: 'Great onboarding presentation for the new engineering cohort!' }
],
tickets: [
{ id: 301, user: 'Siddharth Nair', subject: 'Tax Declaration Verification', priority: 'High', status: 'Open' }
]
};
function loadState() {
const stored = localStorage.getItem('saarthi_os_state');
return stored ? JSON.parse(stored) : DEFAULT_DATA;
}
function saveState() {
localStorage.setItem('saarthi_os_state', JSON.stringify(appState));
}
let appState = loadState();
let currentTab = 'dashboard';
// ROLE NAVIGATION STRUCTURE
const ROLE_CONFIG = {
founder: {
badge: 'FOUNDER / CEO',
nav: [
{ id: 'dashboard', label: 'Executive Dashboard', icon: 'fa-chart-pie' },
{ id: 'playbook', label: 'Founders' Playbook', icon: 'fa-book-bookmark' },
{ id: 'rewards', label: 'Rewards & Culture', icon: 'fa-trophy' },
{ id: 'leaves', label: 'Leave Approvals', icon: 'fa-calendar-check' },
{ id: 'reimbursements', label: 'Expense Claims', icon: 'fa-receipt' },
{ id: 'helpdesk', label: 'Support Helpdesk', icon: 'fa-headset' }
]
},
hr: {
badge: 'PEOPLE OPS / HR',
nav: [
{ id: 'dashboard', label: 'People Ops Hub', icon: 'fa-users-gear' },
{ id: 'playbook', label: 'Founders' Playbook', icon: 'fa-book-bookmark' },
{ id: 'onboarding', label: 'Onboarding Engine', icon: 'fa-user-plus' },
{ id: 'leaves', label: 'Leave Management', icon: 'fa-calendar-check' },
{ id: 'reimbursements', label: 'Reimbursements', icon: 'fa-receipt' },
{ id: 'helpdesk', label: 'Helpdesk Tickets', icon: 'fa-headset' }
]
},
manager: {
badge: 'TEAM MANAGER',
nav: [
{ id: 'dashboard', label: 'Team Dashboard', icon: 'fa-users' },
{ id: 'leaves', label: 'Team Leave Requests', icon: 'fa-calendar-check' },
{ id: 'reimbursements', label: 'Expense Approvals', icon: 'fa-receipt' },
{ id: 'rewards', label: 'Give Shoutout', icon: 'fa-trophy' }
]
},
employee: {
badge: 'EMPLOYEE SELF-SERVICE',
nav: [
{ id: 'dashboard', label: 'My Workspace', icon: 'fa-house-user' },
{ id: 'leaves', label: 'My Leaves', icon: 'fa-calendar-days' },
{ id: 'reimbursements', label: 'My Expense Claims', icon: 'fa-receipt' },
{ id: 'rewards', label: 'Recognition Wall', icon: 'fa-trophy' },
{ id: 'helpdesk', label: 'HR Helpdesk', icon: 'fa-circle-question' }
]
},
candidate: {
badge: 'CANDIDATE PORTAL',
nav: [
{ id: 'candidate_portal', label: 'Application Status', icon: 'fa-file-signature' },
{ id: 'helpdesk', label: 'Candidate Support', icon: 'fa-headset' }
]
}
};
// INIT APP
window.onload = function() {
document.getElementById('roleSelector').value = appState.activeRole;
renderApp();
};
function changeRole(role) {
appState.activeRole = role;
saveState();
const allowedTabs = ROLE_CONFIG[role].nav.map(n => n.id);
if (!allowedTabs.includes(currentTab)) {
currentTab = allowedTabs[0];
}
renderApp();
}
function switchTab(tabId) {
currentTab = tabId;
renderApp();
}
function renderApp() {
const config = ROLE_CONFIG[appState.activeRole];
document.getElementById('roleBadge').innerText = config.badge;
// Render Sidebar Nav
const navContainer = document.getElementById('sideNav');
navContainer.innerHTML = config.nav.map(item => ⁠<button onclick="switchTab('${item.id}')" class="w-full flex items-center space-x-3 px-3 py-2.5 text-xs font-semibold rounded-xl transition ${currentTab === item.id ? 'bg-indigo-50 text-indigo-700 font-bold' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'}"> <i class="fa-solid ${item.icon} w-4 text-center ${currentTab === item.id ? 'text-indigo-600' : 'text-slate-400'}"></i> <span>${item.label}</span> </button>⁠).join('');
// Update Summary Stats
const pendingLeaves = appState.leaves.filter(l => l.status === 'Pending').length;
const pendingClaims = appState.reimbursements.filter(r => r.status === 'Pending').length;
document.getElementById('statApprovals').innerText = pendingLeaves + pendingClaims;
// Render View Content
const mainContent = document.getElementById('mainContent');
switch(currentTab) {
case 'dashboard': renderDashboard(mainContent); break;
case 'playbook': renderPlaybook(mainContent); break;
case 'onboarding': renderOnboarding(mainContent); break;
case 'leaves': renderLeaves(mainContent); break;
case 'reimbursements': renderReimbursements(mainContent); break;
case 'rewards': renderRewards(mainContent); break;
case 'helpdesk': renderHelpdesk(mainContent); break;
case 'candidate_portal': renderCandidatePortal(mainContent); break;
default: renderDashboard(mainContent);
}
}
// DASHBOARD VIEWS
function renderDashboard(container) {
const role = appState.activeRole;
if (role === 'candidate') {
renderCandidatePortal(container);
return;
}
let content = `
<div class="space-y-6">
<div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-6 rounded-2xl text-white shadow-xl relative overflow-hidden">
