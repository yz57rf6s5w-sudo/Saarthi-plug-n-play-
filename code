<h1 class="text-2xl font-bold mt-1">Hello, ${role === 'founder' ? 'Founder & CEO' : role === 'hr' ? 'People Leader' : role === 'manager' ? 'Engineering Lead' : 'Senior Software Engineer'} 👋</h1>
<p class="text-xs text-slate-300 mt-1 max-w-xl">Saarthi People OS is active. All workflows, policies, and team operations are running smoothly.</p>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
<div>
<p class="text-xs font-medium text-slate-500">Team Headcount</p>
<p class="text-2xl font-bold text-slate-900 mt-1">28</p>
<p class="text-[10px] text-emerald-600 font-semibold mt-1">↑ +3 this month</p>
</div>
<div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl"><i class="fa-solid fa-users text-lg"></i></div>
</div>
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
<div>
<p class="text-xs font-medium text-slate-500">Pending Approvals</p>
<p class="text-2xl font-bold text-slate-900 mt-1">${appState.leaves.filter(l => l.status==='Pending').length + appState.reimbursements.filter(r => r.status==='Pending').length}</p>
<p class="text-[10px] text-amber-600 font-semibold mt-1">Action needed</p>
</div>
<div class="p-3 bg-amber-50 text-amber-600 rounded-xl"><i class="fa-solid fa-clock-rotate-left text-lg"></i></div>
</div>
<div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
<div>
<p class="text-xs font-medium text-slate-500">Culture & Peer Kudos</p>
<p class="text-2xl font-bold text-slate-900 mt-1">${appState.shoutouts.length}</p>
<p class="text-[10px] text-purple-600 font-semibold mt-1">High engagement</p>
</div>
<div class="p-3 bg-purple-50 text-purple-600 rounded-xl"><i class="fa-solid fa-trophy text-lg"></i></div>
</div>
</div>
<!-- RECENT ACTIVITY TABLE -->
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
<h3 class="text-sm font-bold text-slate-900 mb-4">Pending Leave & Expense Approvals</h3>
<div class="overflow-x-auto">
<table class="w-full text-left text-xs text-slate-600">
<thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-100">
<tr>
<th class="p-3">Type</th>
<th class="p-3">Requested By</th>
<th class="p-3">Details</th>
<th class="p-3">Status</th>
<th class="p-3">Action</th>
</tr>
</thead>
<tbody class="divide-y divide-slate-100">
${appState.leaves.filter(l => l.status==='Pending').map(l => ⁠<tr> <td class="p-3 font-semibold text-indigo-600">Leave</td> <td class="p-3 font-medium text-slate-800">${l.employee}</td> <td class="p-3">${l.type} (${l.days} days)</td> <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-semibold">Pending</span></td> <td class="p-3 space-x-2"> <button onclick="approveLeave(${l.id})" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 rounded-lg">Approve</button> </td> </tr>⁠).join('')}
${appState.reimbursements.filter(r => r.status==='Pending').map(r => ⁠<tr> <td class="p-3 font-semibold text-purple-600">Expense</td> <td class="p-3 font-medium text-slate-800">${r.employee}</td> <td class="p-3">${r.desc} (${r.amount})</td> <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800 font-semibold">Pending</span></td> <td class="p-3"> <button onclick="approveClaim(${r.id})" class="text-xs bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 rounded-lg">Approve</button> </td> </tr>⁠).join('')}
${appState.leaves.filter(l => l.status==='Pending').length === 0 && appState.reimbursements.filter(r => r.status==='Pending').length === 0 ? ⁠<tr><td colspan="5" class="p-4 text-center text-slate-400">No pending approvals left. Excellent work!</td></tr>⁠ : ''}
</tbody>
</table>
</div>
</div>
</div>
`;
container.innerHTML = content;
}
