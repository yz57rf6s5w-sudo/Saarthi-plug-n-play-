function sendAiQuery() {
const input = document.getElementById('aiInput');
const query = input.value.trim();
if (!query) return;
const chatBox = document.getElementById('aiChatBox');
chatBox.innerHTML += ⁠<div class="flex justify-end"> <div class="bg-indigo-600 text-white p-3 rounded-2xl rounded-tr-none text-xs max-w-[80%] shadow-sm"> ${query} </div> </div>⁠;
input.value = '';
chatBox.scrollTop = chatBox.scrollHeight;
setTimeout(() => {
let answer = "I can help with that! In Saarthi People OS, you can submit claims under Reimbursements, track leave balances, or explore early-stage startup frameworks in the Founders' Playbook.";
if (query.toLowerCase().includes('leave')) {
answer = "To apply for leave, navigate to the Leave Management tab in your side navigation bar and click on '+ Apply Leave'.";
} else if (query.toLowerCase().includes('esop') || query.toLowerCase().includes('equity')) {
answer = "According to the Founders' Playbook: Standard startup equity vesting uses a 4-year schedule with a 1-year cliff, reserving 10-12% pool for early talent.";
}
chatBox.innerHTML += ⁠<div class="flex justify-start"> <div class="bg-white border border-slate-200 text-slate-800 p-3 rounded-2xl rounded-tl-none text-xs max-w-[80%] shadow-sm space-y-1"> <p class="font-bold text-[10px] text-indigo-600">Saarthi AI</p> <p>${answer}</p> </div> </div>⁠;
chatBox.scrollTop = chatBox.scrollHeight;
}, 500);
}
