<div class="bg-slate-900 text-white p-4 flex justify-between items-center border-b border-slate-800">
<div class="flex items-center space-x-2">
<div class="bg-indigo-600 p-1.5 rounded-lg">
<i class="fa-solid fa-robot text-sm"></i>
</div>
<div>
<h3 class="font-semibold text-sm">Saarthi AI Assistant</h3>
<p class="text-[10px] text-slate-400">Context-Aware HR & Operations Guide</p>
</div>
</div>
<button onclick="closeAiAssistant()" class="text-slate-400 hover:text-white transition text-lg"><i class="fa-solid fa-xmark"></i></button>
</div>
<div id="aiChatBox" class="flex-1 p-4 overflow-y-auto space-y-3 custom-scrollbar bg-slate-50">
